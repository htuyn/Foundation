# Keep this file UTF-8 without BOM so Vite reads the first variable.
VITE_API_BASE_URL=/api/v1
# Set the public frontend origin in Vercel Production; local development may leave this empty.
VITE_SCANNER_MOBILE_BASE_URL=
VITE_SCANNER_SCAN_COOLDOWN_MS=1800
VITE_DEV_API_TARGET=http://127.0.0.1:8000
BACKEND_PORT=8000
DEV_HTTPS_CERT_FILE=
DEV_HTTPS_KEY_FILE=
DEV_HTTPS_CERT_FILE_DOCKER=
DEV_HTTPS_KEY_FILE_DOCKER=
APP_ENV=development
APP_NAME=Smart Warehouse API
POSTGRES_DB=warehouse_db
POSTGRES_USER=warehouse_user
POSTGRES_PASSWORD=replace-me-with-a-local-secret
POSTGRES_PORT=5433
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
SCANNER_SESSION_TTL_SECONDS=600
SCANNER_QR_TTL_SECONDS=60
