# Keep this file UTF-8 without BOM so Vite reads the first variable.
VITE_API_BASE_URL=/api/v1
# Production (Vercel): đặt origin công khai của frontend, ví dụ https://your-app.vercel.app
# Development local: để trống — chạy `npm run dev:mobile` để tự động tạo Cloudflare tunnel HTTPS
VITE_SCANNER_MOBILE_BASE_URL=
VITE_SCANNER_SCAN_COOLDOWN_MS=1800
VITE_DEV_API_TARGET=http://127.0.0.1:8000
# (Tuỳ chọn) Đường dẫn tới cloudflared nếu không có trong PATH — dùng bởi npm run dev:mobile
# Windows mặc định: C:\Program Files (x86)\cloudflared\cloudflared.exe
CLOUDFLARED_BIN=
BACKEND_PORT=8000
DEV_HTTPS_CERT_FILE=
DEV_HTTPS_KEY_FILE=
DEV_HTTPS_CERT_FILE_DOCKER=
DEV_HTTPS_KEY_FILE_DOCKER=
APP_ENV=development
APP_NAME=Smart Warehouse API
POSTGRES_DB=warehouse_db
POSTGRES_USER=warehouse_user
POSTGRES_PASSWORD= thay mat khau postgre vao day
POSTGRES_PORT=5433
CORS_ORIGINS=http://localhost:5173,https://localhost:5173,http://127.0.0.1:5173,https://127.0.0.1:5173,http://localhost:4173
# Cho phép Cloudflare Quick Tunnel (dev:mobile) và IP LAN với HTTPS cert
CORS_ORIGIN_REGEX=^https://[a-z0-9-]+\.trycloudflare\.com$
AUTH_SECRET_KEY=
AUTH_COOKIE_DOMAIN=
SCANNER_SESSION_TTL_SECONDS=600
SCANNER_QR_TTL_SECONDS=60
